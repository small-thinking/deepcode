[
  {
    "name": "allows a job to start exactly when another job ends",
    "input": "four overlapping and adjacent jobs",
    "test": "assert job_scheduling([1, 2, 3, 3], [3, 4, 5, 6], [50, 10, 40, 70]) == 120"
  },
  {
    "name": "chooses one job among a fully overlapping set and handles a singleton",
    "input": "three simultaneous jobs followed by one standalone job",
    "test": "assert job_scheduling([1, 1, 1], [2, 2, 2], [30, 20, 10]) == 30\nassert job_scheduling([5], [10], [100]) == 100"
  },
  {
    "name": "finds optimal chains across nonconsecutive time values",
    "input": "two weighted interval scheduling examples",
    "test": "assert job_scheduling([2, 4, 6, 6], [4, 7, 8, 10], [45, 15, 35, 80]) == 125\nassert job_scheduling([1, 3, 5, 6, 8], [3, 5, 9, 8, 11], [25, 30, 110, 65, 55]) == 175\nassert job_scheduling([], [], []) == 0"
  }
]
