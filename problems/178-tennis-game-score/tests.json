  },
  {
    "name": "Advantage B example",
    "input": "points = [B, A, B, A, B, A, B]",
    "test": "assert tennis_score(['B', 'A', 'B', 'A', 'B', 'A', 'B']) == 'Advantage B'"
  },
  {
    "name": "Game B example",
    "input": "points = [A, B, A, B, A, B, B, B]",
    "test": "assert tennis_score(['A', 'B', 'A', 'B', 'A', 'B', 'B', 'B']) == 'Game B'"
  }
