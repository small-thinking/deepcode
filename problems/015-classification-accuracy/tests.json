[
  {
    "name": "half correct",
    "input": "y_true = [1, 0, 1, 1], y_pred = [1, 1, 1, 0]",
    "test": "print(classification_accuracy([1, 0, 1, 1], [1, 1, 1, 0]))",
    "expected_output": "0.5"
  },
  {
    "name": "all correct strings",
    "input": "y_true = ['cat', 'dog'], y_pred = ['cat', 'dog']",
    "test": "print(classification_accuracy(['cat', 'dog'], ['cat', 'dog']))",
    "expected_output": "1.0"
  },
  {
    "name": "invalid shapes",
    "input": "y_true = [1, 0], y_pred = [1]",
    "test": "try:\n    result = classification_accuracy([1, 0], [1])\nexcept (AssertionError, ValueError):\n    pass\nelse:\n    assert result == -1, \"invalid input must be rejected\"\nprint(\"rejected\")\n",
    "expected_output": "rejected"
  },
  {
    "name": "rounds repeating fraction",
    "input": "y_true = [0, 1, 2], y_pred = [0, 2, 2]",
    "test": "print(classification_accuracy([0, 1, 2], [0, 2, 2]))",
    "expected_output": "0.6667"
  },
  {
    "name": "none correct",
    "input": "y_true = ['spam', 'ham', 'ham'], y_pred = ['ham', 'spam', 'spam']",
    "test": "print(classification_accuracy(['spam', 'ham', 'ham'], ['ham', 'spam', 'spam']))",
    "expected_output": "0.0"
  },
  {
    "name": "both inputs empty",
    "input": "y_true = [], y_pred = []",
    "test": "try:\n    result = classification_accuracy([], [])\nexcept (AssertionError, ValueError):\n    pass\nelse:\n    assert result == -1, \"invalid input must be rejected\"\nprint(\"rejected\")\n",
    "expected_output": "rejected"
  },
  {
    "name": "case-sensitive string labels",
    "input": "y_true = ['cat', 'Cat'], y_pred = ['cat', 'cat']",
    "test": "print(classification_accuracy(['cat', 'Cat'], ['cat', 'cat']))",
    "expected_output": "0.5"
  }
]
