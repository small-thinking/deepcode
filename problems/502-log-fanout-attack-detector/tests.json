[
  {
    "name": "strict default threshold",
    "input": "11 different destinations within 10 minutes",
    "test": "events = [(i, 's', str(i)) for i in range(11)]\nassert detect_fanout(events) == [(10, 's')]"
  },
  {
    "name": "repeated destinations",
    "input": "multiple connections to the same destination",
    "test": "events = [(0,'s','a'), (1,'s','a'), (2,'s','b'), (3,'s','c'), (4,'s','a')]\nassert detect_fanout(events, 10, 2) == [(3,'s'), (4,'s')]"
  },
  {
    "name": "expiration uses an open left boundary",
    "input": "an event exactly window_seconds old expires",
    "test": "events = [(0,'s','a'), (1,'s','b'), (10,'s','c'), (11,'s','d')]\nassert detect_fanout(events, 10, 2) == []"
  },
  {
    "name": "destination stays until its last event expires",
    "input": "duplicate destinations straddle expiration",
    "test": "events = [(0,'s','a'), (5,'s','a'), (6,'s','b'), (10,'s','c'), (15,'s','d')]\nassert detect_fanout(events, 10, 2) == [(10,'s'), (15,'s')]"
  },
  {
    "name": "source isolation and equal timestamps",
    "input": "two source IPs interleaved",
    "test": "events = [(0,'s','a'), (0,'x','a'), (0,'s','b'), (0,'x','a'), (0,'x','b')]\nassert detect_fanout(events, 5, 1) == [(0,'s'), (0,'x')]"
  },
  {
    "name": "empty input and zero threshold",
    "input": "no events and a single event",
    "test": "assert detect_fanout([]) == []\nassert detect_fanout([(3,'s','a')], 1, 0) == [(3,'s')]"
  }
]
