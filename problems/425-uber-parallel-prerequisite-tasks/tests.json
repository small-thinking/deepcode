    "input": "two tasks depend on each other",
    "test": "assert solution(2, [(1,2),(2,1)]) == -1"
  },
  {
    "name": "handles no tasks and no dependencies",
    "input": "n=0 and three independent tasks",
    "test": "assert solution(0, []) == 0\nassert solution(3, []) == 1"
  }
