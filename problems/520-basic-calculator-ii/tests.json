    "expected_output": "5"
  },
  {
    "name": "multi-digit number",
    "input": "'12345'",
    "test": "print(calculate_ii('12345'))",
    "expected_output": "12345"
  },
  {
    "name": "negative term truncates toward zero",
    "input": "'0-7/2'",
    "test": "print(calculate_ii('0-7/2'))",
